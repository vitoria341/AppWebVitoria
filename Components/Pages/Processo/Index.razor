@page "/processos"
@using AppWebVitoria.Model
@using AppWebVitoria.DAO
@inject ProcessoDAO ProcessoDAO

<PageTitle> Processos  -  Sistema de Controle de Processos </PageTitle>



<div class="d-flex justify-content-btween align-items-center mb-a">
    <div>
        <h2>Consulta de Processos</h2>
    </div>
</div>

<div class="custom-table-card">
    <div class="table-responsive">

        <table class="table align-middle"
        <thead>
            <tr>
                <th>Id</th>
                <th>Número</th>
                <th>Interessado</th>
                <th>Assunto</th>
                <th>Situação</th>
                <th>Ações</th>
             </tr>
        </thead>
        <tbody>
            @foreach (var processo in processos)
            {
                    <tr>
                        <td>1</td>
                        <td>4321</td>
                        <td>Vitória Ferreira</td>
                        <td>Solicitação de Ligação de Energia</td>
                        <td>Aberto</td>
                        <td>5</td>
                    </tr>
                }
           
        </tbody>
        </table>
        </div>
    </div>
    
@code {
    private List<Processos> processos = new();
    protected override void OnInitialized()
    {
        // Chama o DAO para buscar os dados no banco
        processos = ProcessoDAO.Listar();
    }
}
